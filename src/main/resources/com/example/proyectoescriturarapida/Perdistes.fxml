<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="581.0" prefWidth="667.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectoescriturarapida.controller.PerdistesController">
   <children>
      <AnchorPane prefHeight="581.0" prefWidth="667.0">
         <children>

            <!-- Fondo -->
            <ImageView fitHeight="581.0" fitWidth="667.0" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <image>
                  <Image url="@images/perdistes.jpeg" />
               </image>
            </ImageView>

            <!-- Panel semi-transparente superior para estadísticas -->
            <!-- Nivel alcanzado -->
            <Label fx:id="lblNiveles" alignment="CENTER" layoutX="24.0" layoutY="43.0" prefHeight="38.0" prefWidth="600.0" style="-fx-text-fill: #f1c40f; -fx-font-family: Impact; -fx-font-size: 28;                           -fx-background-color: rgba(0,0,0,0.55); -fx-background-radius: 8;                           -fx-effect: dropshadow(gaussian, black, 6, 0.5, 0, 0);" />

            <!-- Puntuacion -->
            <Label fx:id="lblPuntos" alignment="CENTER" layoutX="34.0" layoutY="83.0" prefHeight="34.0" prefWidth="600.0" style="-fx-text-fill: #ecf0f1; -fx-font-family: Impact; -fx-font-size: 22;                           -fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 8;" />

            <!-- Causa del fallo -->
            <Label fx:id="lblCausa" alignment="CENTER" layoutX="34.0" layoutY="299.0" prefHeight="32.0" prefWidth="600.0" style="-fx-text-fill: #e74c3c; -fx-font-family: Impact; -fx-font-size: 20;                           -fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 8;" />

            <!-- Tiempo restante -->
            <Label fx:id="lblTiempoRestante" alignment="CENTER" layoutX="34.0" layoutY="243.0" prefHeight="28.0" prefWidth="600.0" style="-fx-text-fill: #bdc3c7; -fx-font-family: Impact; -fx-font-size: 18;                           -fx-background-color: rgba(0,0,0,0.45); -fx-background-radius: 8;" />

            <!-- Boton REINTENTAR (parte baja, fuera del GAME OVER) -->
            <Button fx:id="btnReintentar" layoutX="234.0" layoutY="345.0" mnemonicParsing="false" onAction="#handleRestart" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #c0392b; -fx-text-fill: white;                            -fx-font-family: Impact; -fx-font-size: 24;                            -fx-background-radius: 24; -fx-cursor: hand;" text="REINTENTAR" />

         </children>
      </AnchorPane>
   </children>
</VBox>
